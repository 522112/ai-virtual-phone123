# 自部署默认推荐开启：跳过作者官方账号/激活码系统，使用本地单机账号。
# 作者自己的 Netlify 链接版不要设置这个变量。
NEXT_PUBLIC_SELF_HOSTED_MODE=true

# 可选：如果你要启用自己的 Supabase 云端功能，请填写自己的项目，不要使用作者的项目。
#需要先在Supabase SQL编辑器执行docs/*.sql中对应功能的建表脚本。
SUPABASE_URL=
SUPABBASE_SERVICE_ROLE_KEY=

# 独家特调（酒材页 / 配方页）专用的独立 Supabase 项目。特调的表、RPC 与全部读写只认
# 这两个变量，不会回退到上面的主库；不填就等于特调云端未开张。
#需要先在这个项目的SQL编辑器执行docs/mixology-subbase.sql。
mixology_SUPABASE_URL=
mixology_SUABBASE_SERVICE_ROLE_KEY=

# 可选：现实桥“邮件自动执行”实验模式。先在 Resend 验证自己的发信域名，
# 再配置 API Key 和该域名下的发件地址。验证码密钥建议使用独立随机长字符串。
resend_API_KEY=
reality_BRIDGE_EMAIL_FROM="浮动现实桥<bridge@your-domain.example>"
shortcut_EMAIL_VERIFICATION_SECRET=
# 可选：账号门禁签名密钥。启用账号系统时建议设置为随机长字符串。
account_GATE_SECRET=

# 可选：成年审核/激活码后台管理密钥。
verify_ADMIN_KEY=

#可选：应用市场审核后台密钥。不填时会回退使用verify_ADMIN_KEY。
app_MARKET_ADMIN_KEY=

#可选：启用便签墙实时刷新才需要。注意next_PUBLIC_*会公开到浏览器，不要放服务角色(_R)。
next_PUBLIC_SUPABASE_URL=
next_PUBLIC_SUPABASE_ANON_KEY=
next_PUBLIC_SUPABASE_publishable_KEY=

# 可选：第三方能力的服务端兜底 key。一般不用填——用户可在应用内自行填写
#(Tripo在世界搭建界面，ImgBB在生图/病床设置).
tripo_API_KEY=
IMGBB_API_KEY=
Weixin_PROXY=
next_PUBLIC_IMAGE_GEN_PROXY_URL=
#可选：网易云音乐API(网易云音乐API兼容实例）。留空时在线音乐功能隐藏，
# 用户也可在音乐 APP 设置里自行填写。请部署你自己的实例，不要使用他人的。
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=https://olxeixzylbbo.sealoshzh.site
# 可选：仅当你更换过默认音乐 API 地址时需要。旧地址填这里（逗号分隔），
# 老用户浏览器里存的旧地址会自动迁移到当前默认。
next_PUBLIC_LEGACY_NetEase_API_BASES=
next_PUBLIC_网易_REAL_IP=
